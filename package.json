{
  "name": "mediconnect-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.0",
    "@hookform/resolvers": "^7.0.6",
    "@mediconnect/api-client": "link:../shared/packages/api-client",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.0",
    "expo-device": "~58.0.0",
    "expo-font": "~58.0.0",
    "expo-glass-effect": "~58.0.0",
    "expo-image": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-network": "~58.0.0",
    "expo-router": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-symbols": "~58.0.0",
    "expo-system-ui": "~58.0.0",
    "expo-web-browser": "~58.0.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mediconnect/design-system": "link:../shared/packages/design-system",
    "@playwright/test": "^1.65.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "e2e": "playwright test",
    "e2e:shots": "SHOTS=1 playwright test",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/e2e/"
    ],
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  }
}
